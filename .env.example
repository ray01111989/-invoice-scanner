# Anthropic API key (console.anthropic.com). Server-side only.
ANTHROPIC_API_KEY=

# Supabase project URL and SERVICE ROLE key (Project Settings > API). Server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Shared password for the site. Strongly recommended: without it, anyone with the link can
# add, view, and delete records and spend your Anthropic credits. Use a long random value.
APP_ACCESS_KEY=
